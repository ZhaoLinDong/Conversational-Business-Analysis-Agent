  "metrics": {
    "product_sales_amount": {
      "指标编码": "product_sales_amount",
      "指标名称": "商品销售额",
      "业务别名": [
        "销售额",
        "成交额",
        "营收"
      ],
      "业务定义": "已送达订单的商品成交金额，不含运费",
      "SQL模板": "WITH o AS (SELECT DISTINCT * FROM orders WHERE purchase_at >= ? AND purchase_at <= ?), oi AS (SELECT DISTINCT * FROM order_items), p AS (SELECT DISTINCT * FROM products), c AS (SELECT DISTINCT * FROM categories), s AS (SELECT DISTINCT * FROM sellers) SELECT {dim_prefix}ROUND(SUM(oi.price), 2) AS value FROM oi JOIN o ON oi.order_id = o.order_id LEFT JOIN p ON oi.product_id = p.product_id LEFT JOIN c ON p.category_id = c.category_id LEFT JOIN s ON oi.seller_id = s.seller_id WHERE o.order_status = 'delivered' {group_by} ORDER BY value DESC LIMIT ?",
      "允许维度": [
        "month",
        "category",
        "seller"
      ],
      "时间字段": "orders.purchase_at"
    },
    "delivered_order_count": {
      "指标编码": "delivered_order_count",
      "指标名称": "已送达订单数",
      "业务别名": [
        "已送达订单数",
        "送达订单数",
        "完成订单数"
      ],
      "业务定义": "状态为已送达的订单数量",
      "SQL模板": "WITH o AS (SELECT DISTINCT * FROM orders WHERE purchase_at >= ? AND purchase_at <= ?), oi AS (SELECT DISTINCT * FROM order_items), p AS (SELECT DISTINCT * FROM products), c AS (SELECT DISTINCT * FROM categories), s AS (SELECT DISTINCT * FROM sellers) SELECT {dim_prefix}COUNT(DISTINCT o.order_id) AS value FROM o LEFT JOIN oi ON oi.order_id = o.order_id LEFT JOIN p ON oi.product_id = p.product_id LEFT JOIN c ON p.category_id = c.category_id LEFT JOIN s ON oi.seller_id = s.seller_id WHERE o.order_status = 'delivered' {group_by} ORDER BY value DESC LIMIT ?",
      "允许维度": [
        "month",
        "category",
        "seller"
      ],
      "时间字段": "orders.purchase_at"
    }
  },
